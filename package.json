      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "skills": [
      "skills"
    ],
    "app": "./app.tsx"
  },
  "dependencies": {
    "zod": "^4.3.6",
    "@radix-ui/react-slot": "^1.3.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.87",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.10.1",
    "hono": "^4.13.7",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "vitest": "^3.2.0",
    "jsdom": "^26.0.0",
    "@testing-library/react": "^16.3.0"
